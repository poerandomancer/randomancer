{
  "schema_version": "0.1",
  "description": "Skill Family Library for Challenge Mode. Families are resolved by tag queries over the union of taxonomy.gem_tags, taxonomy.skill_types, and effect_tags on each skill (skills_enriched.json).",
  "resolution_rules": {
    "skill_pool_filter": "Active skills only; exclude support gems; exclude DNT/Unused by id or name. Buff/persistent/spirit skills are allowed.",
    "tag_union": [
      "taxonomy.gem_tags",
      "taxonomy.skill_types",
      "effect_tags"
    ],
    "dedupe_per_skill": true,
    "normalization": "Lowercase; remove non-alphanumeric; apply alias_to_canonical mapping."
  },
  "tag_normalization": {
    "strip_chars_regex": "[^a-z0-9]+",
    "alias_to_canonical": {
      "bleeding": "bleed",
      "bleeds": "bleed",
      "bleedable": "bleed",
      "poisons": "poison",
      "poisonable": "poison",
      "ignites": "ignite",
      "igniteable": "ignite",
      "shocks": "shock",
      "shockable": "shock",
      "frozen": "freeze",
      "freezing": "freeze",
      "freezes": "freeze",
      "freezable": "freeze",
      "projectiles": "projectile",
      "minions": "minion",
      "corpses": "corpse"
    },
    "canonical_to_aliases": {
      "bleed": [
        "bleeding",
        "bleeds",
        "bleedable"
      ],
      "poison": [
        "poisons",
        "poisonable"
      ],
      "ignite": [
        "ignites",
        "igniteable"
      ],
      "shock": [
        "shocks",
        "shockable"
      ],
      "freeze": [
        "frozen",
        "freezing",
        "freezes",
        "freezable"
      ],
      "projectile": [
        "projectiles"
      ],
      "minion": [
        "minions"
      ],
      "corpse": [
        "corpses"
      ]
    }
  },
